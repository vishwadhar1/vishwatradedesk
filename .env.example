# Neon Postgres connection string
DATABASE_URL=

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Google OAuth client (console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of emails allowed to sign in
ALLOWED_EMAILS=

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=

# Bearer token required by /api/cron/* routes
CRON_SECRET=
